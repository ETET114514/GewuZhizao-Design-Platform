{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gewu.local/schemas/interior-catalog-v1.json",
  "title": "Gewu interior asset catalog",
  "type": "object",
  "required": ["schemaVersion", "units", "assets"],
  "properties": {
    "schemaVersion": { "const": "gewu-interior-catalog-v1" },
    "name": { "type": "string" },
    "units": { "const": "millimeters" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "depth", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "center": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["id", "name", "category", "dimensionsMillimeters", "collision", "placement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/id" },
        "categoryLabel": { "type": "string" },
        "subcategory": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "model": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "pattern": "\\.(glb|gltf)([?#].*)?$" },
            "format": { "enum": ["glb", "gltf"] }
          },
          "additionalProperties": true
        },
        "dimensionsMillimeters": { "$ref": "#/$defs/dimensions" },
        "collision": {
          "type": "object",
          "required": ["type", "sizeMillimeters", "centerMillimeters"],
          "properties": {
            "type": { "const": "box" },
            "sizeMillimeters": { "$ref": "#/$defs/dimensions" },
            "centerMillimeters": { "$ref": "#/$defs/center" },
            "clearanceMillimeters": { "type": "number", "minimum": 0 },
            "scaleWithModel": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "placement": {
          "type": "object",
          "required": ["mount"],
          "properties": {
            "mount": { "enum": ["floor", "wall", "ceiling"] },
            "defaultElevationMillimeters": { "type": "number", "minimum": 0 },
            "rotationStepDegrees": { "type": "number", "exclusiveMinimum": 0 },
            "allowWallOverlap": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
